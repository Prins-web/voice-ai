{
  "version": 2,
  "builds": [
    { "src": "api/translate.js", "use": "@vercel/node" },
    { "src": "api/edit.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/translate", "dest": "/api/translate.js" },
    { "src": "/api/edit", "dest": "/api/edit.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
